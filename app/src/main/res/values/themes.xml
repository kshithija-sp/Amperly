<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Amperly's design system: the pixel/volt shell language applied to every screen.

      Dark garage background, lifted cards with a hairline, one volt accent that always
      carries dark ink, and a single sans-serif family with heavy weights for headings. The
      app is dark-only: this file is the single palette, with no day/night split, so every
      page restyles from the tokens here without a fragment being touched.
    -->

    <style name="Base.Theme.Amperly" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/volt</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/volt_soft</item>
        <item name="colorOnPrimaryContainer">@color/volt</item>
        <item name="colorPrimaryInverse">@color/on_accent</item>

        <item name="colorSecondary">@color/volt_deep</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/amp_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>

        <item name="colorTertiary">@color/warning</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/warning_soft</item>
        <item name="colorOnTertiaryContainer">@color/amp_on_tertiary_container</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_accent</item>
        <item name="colorErrorContainer">@color/danger_soft</item>
        <item name="colorOnErrorContainer">@color/amp_on_error_container</item>

        <item name="android:colorBackground">@color/app_bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_alt</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_highest</item>
        <item name="colorSurfaceVariant">@color/stroke</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/stroke_light</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@color/app_bg</item>

        <item name="materialCardViewStyle">@style/Widget.Amperly.Card</item>
        <item name="materialButtonStyle">@style/Widget.Amperly.Button</item>
        <item name="chipStyle">@style/Widget.Amperly.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Amperly.Dialog</item>
    </style>

    <style name="Theme.Amperly" parent="Base.Theme.Amperly" />

    <style name="ThemeOverlay.Amperly.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Amperly.Dialog</item>
    </style>

    <style name="ShapeAppearance.Amperly.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ============================================================== Buttons -->

    <style name="Widget.Amperly.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/volt</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33000000</item>
    </style>

    <style name="Widget.Amperly.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/volt_soft</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Amperly.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">46dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="rippleColor">#1AFFFFFF</item>
    </style>

    <!-- The local shell's older name for the same outlined action. -->
    <style name="Widget.Amperly.Button.Outline" parent="Widget.Amperly.Button.Outlined" />

    <style name="Widget.Amperly.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">46dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
    </style>

    <style name="Widget.Amperly.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">50dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Amperly.Button.Dark" parent="Widget.Material3.Button">
        <item name="android:minHeight">50dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ================================================================ Cards -->

    <style name="Widget.Amperly.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">@color/stroke_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Amperly.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Widget.Amperly.Card.Map" parent="Widget.Amperly.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- The dark gradient banner that opens a page. -->
    <style name="Widget.Amperly.Card.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:background">@drawable/bg_hero</item>
    </style>

    <style name="Widget.Amperly.Card.Side" parent="Widget.Amperly.Card">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.Amperly.StatTile" parent="Widget.Amperly.Card">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/amp_stat_tile_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/amp_space_xs</item>
    </style>

    <!-- ================================================================= Text -->

    <style name="TextAppearance.Amperly.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingMultiplier">1.02</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">25sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Amperly.BodyStrong" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Amperly.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Amperly.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Amperly.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.Price" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- The local shell's shorter type names, kept for shell layouts. -->
    <style name="Text.Kicker" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- =============================================================== Chips -->

    <style name="Widget.Amperly.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/role_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.Amperly.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/amp_badge_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelSmall</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Amperly.Badge.Eyebrow" parent="Widget.Amperly.Badge">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ============================================================== Notices -->

    <style name="Widget.Amperly.Notice" parent="">
        <item name="android:background">@drawable/bg_notice_neutral</item>
        <item name="android:padding">@dimen/amp_space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Body</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Amperly.Notice.Info" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_info</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <style name="Widget.Amperly.Notice.Warning" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_warning</item>
        <item name="android:textColor">@color/amp_on_tertiary_container</item>
    </style>

    <style name="Widget.Amperly.Notice.Error" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_error</item>
        <item name="android:textColor">@color/amp_on_error_container</item>
    </style>

    <style name="Widget.Amperly.Notice.Primary" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_primary</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Amperly.Notice.Mono" parent="Widget.Amperly.Notice">
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Mono</item>
    </style>

    <style name="Widget.Amperly.Badge.Info" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_info</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <style name="Widget.Amperly.Badge.Neutral" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_neutral</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Widget.Amperly.Badge.Warning" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_warning</item>
        <item name="android:textColor">@color/amp_on_tertiary_container</item>
    </style>

    <style name="Widget.Amperly.Badge.Error" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_error</item>
        <item name="android:textColor">@color/amp_on_error_container</item>
    </style>

    <!-- =============================================================== Inputs -->

    <style name="Widget.Amperly.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/amp_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/muted</item>
    </style>

    <!-- ================================================== Bottom navigation -->

    <style name="ShapeAppearance.Amperly.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Amperly.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Amperly.NavLabel.Active" parent="TextAppearance.Amperly.NavLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Amperly.NavIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="shapeAppearance">@style/ShapeAppearance.Amperly.NavIndicator</item>
        <item name="android:color">@color/volt_soft</item>
    </style>

    <!-- ================================================== Brand lock-up -->

    <style name="TextAppearance.Amperly.Wordmark" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ================================================== Role switcher -->

    <style name="Widget.Amperly.RoleChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAllCaps">false</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/role_chip_text</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- ================================================== Section header -->

    <style name="Widget.Amperly.ScreenHeader" parent="Widget.Amperly.Card">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Widget.Amperly.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/stroke_light</item>
    </style>
</resources>
